---
- name: Provision FortiGate
  hosts: all
  gather_facts: false

  vars_files:
    - vars/firewalls.vars

  tasks:

    - name: Get firewall information
      # obtain information dynamically from NetBox
      ...

    - name: Find firewall in firewalls.vars
      ...
      
    - name: Validate firewall
      ...

    - name: Render template
      ansible.builtin.template:
        src: template/hostname_template.j2
        dest: /tmp/hostname.cfg
      delegate_to: localhost

    - name: Show generated configuration
      ansible.builtin.command:
        cmd: cat /tmp/hostname.cfg
      register: generated_config
      delegate_to: localhost

    - name: Print generated configuration
      ansible.builtin.debug:
        var: generated_config.stdout

    - name: Send configuration to FortiGate
      ansible.builtin.raw: "{{ generated_config.stdout }}"
      register: result

    - name: Show result
      ansible.builtin.debug:
        var: result
